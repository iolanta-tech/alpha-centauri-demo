"@context":
  "@import": https://json-ld.org/contexts/dollar-convenience.jsonld
  schema: https://schema.org/
  dbo: http://dbpedia.org/ontology/
  dbp: http://dbpedia.org/property/
  dbr: http://dbpedia.org/resource/
  name: schema:name
  description: schema:description
  ∈: "@type"
  🏷: name
  📝: description
  contains:
    "@id": schema:hasPart
    "@type": "@id"
  is-orbited-by:
    "@reverse": dbp:star
$id: dbr:Alpha_Centauri
🏷: Alpha Centauri
📝: The closest star system to the Solar System.
contains:
  $id: dbr:Alpha_Centauri_AB
  🏷: Alpha Centauri AB
  contains:
    - $id: dbr:Alpha_Centauri_A
      ∈: dbo:Star
      🏷: Alpha Centauri A
    - $id: dbr:Alpha_Centauri_B
      ∈: dbo:Star
      🏷: Alpha Centauri B
  is-orbited-by:
    - $id: dbr:Proxima_Centauri
      ∈: dbo:Star
      🏷: Proxima Centauri
      is-orbited-by:
        - $id: dbr:Proxima_Centauri_b
          ∈: dbo:Planet
          🏷: Proxima Centauri b
        - $id: dbr:Proxima_Centauri_d
          ∈: dbo:Planet
          🏷: Proxima Centauri d
